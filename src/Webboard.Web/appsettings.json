{
  "ConnectionStrings": {
    "WebboardDatabase": ""
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "Webboard",
      "Audience": "Webboard",
      "SigningKey": "",
      "LifetimeHours": 8,
      "RememberMeDays": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Agents": [],
  "Outbound": {
    "AllowedPrivateNetworks": []
  },
  "Monitoring": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "TimeoutSeconds": 5,
    "StaleSeconds": 90,
    "MaxConcurrency": 8,
    "RetentionDays": 30
  }
}
