@page
@model ModuleManagementModel
@using Webboard.Domain.Model.AuditLogs
@{
    var canManage = Model.CanCreate || Model.CanUpdate || Model.CanDelete;
    ViewData["Title"] = canManage ? "Manage modules" : "Arrange modules";
    ViewData["FullWidth"] = true;
}
<div class="mode-bar"><a asp-page="/Index">← Back to modules</a><span class="mode-badge">Arrangement preview</span></div>
<div class="page-heading">
    <div><p class="eyebrow">Your dashboard layout</p><h1>@ViewData["Title"]</h1>
        <p class="text-muted">Drag tiles by their handles to arrange your dashboard. Changes are personal to this browser.</p></div>
    @if (Model.CanCreate) {
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#module-modal" data-module-action="add">Add module</button>
    }
</div>
@if (TempData["StatusMessage"] is string statusMessage) { <div class="alert alert-success" role="status">@statusMessage</div> }
@if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger" role="alert">@errorMessage</div> }
@if (Model.VisibleModules.Count == 0) {
    <div class="empty-state"><h2>No visible modules to arrange</h2><p class="text-muted">Enabled modules will appear in this preview.</p></div>
} else {
    <div class="arrangement-toolbar">
        <span id="arrangement-status" class="small text-muted" role="status" aria-live="polite">Saved in this browser · Drag a handle or use the arrow buttons.</span>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-reset-order>Reset arrangement</button>
    </div>
    <div class="module-grid arrangement-grid" data-module-grid data-arrange="true" data-order-account="@Model.CurrentUserId" aria-label="Module arrangement">
        @foreach (var module in Model.VisibleModules) {
            <article class="card module-tile arrangement-tile" data-module-id="@module.Id" data-module-name="@module.Name">
                <div class="card-body d-flex flex-column">
                    <div class="arrangement-controls">
                        <button class="drag-handle" type="button" aria-label="Drag @module.Name to reorder" title="Drag to reorder"><span aria-hidden="true">⠿</span></button>
                        <span class="arrangement-position small text-muted"></span>
                        <div class="d-flex gap-1 ms-auto" role="group" aria-label="Move @module.Name">
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-move="-1" aria-label="Move @module.Name earlier">←</button>
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-move="1" aria-label="Move @module.Name later">→</button>
                        </div>
                    </div>
                    <h2 class="h5 text-break">@module.Name</h2>
                    <p class="text-muted module-description">@(string.IsNullOrWhiteSpace(module.Description) ? "No description" : module.Description)</p>
                    <div class="small text-muted mt-auto"><span class="module-type-badge">@module.TypeName</span>
                        @if (!string.IsNullOrWhiteSpace(module.HostName)) { <span class="ms-2">@module.HostName</span> }
                    </div>
                    @if (canManage) { <partial name="Shared/_ModuleConfigurationActions" model="module"/> }
                </div>
            </article>
        }
    </div>
}
@if (Model.HiddenModules.Count > 0) {
    <section class="mt-5" aria-labelledby="hidden-modules-title">
        <h2 class="h4" id="hidden-modules-title">Hidden modules</h2>
        <p class="text-muted">These modules are not on your dashboard. Their saved positions are retained when shown again.</p>
        <div class="module-grid">
            @foreach (var module in Model.HiddenModules) {
                <article class="card module-tile module-tile--hidden">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between gap-2"><h3 class="h5 text-break">@module.Name</h3><span class="badge text-bg-secondary align-self-start">Hidden</span></div>
                        <p class="text-muted module-description">@(string.IsNullOrWhiteSpace(module.Description) ? "No description" : module.Description)</p>
                        <div class="small text-muted mt-auto"><span class="module-type-badge">@module.TypeName</span><span class="ms-2">@module.HostName</span></div>
                        <partial name="Shared/_ModuleConfigurationActions" model="module"/>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (Model.CanCreate || Model.CanUpdate) {
    <div class="modal fade" id="module-modal" tabindex="-1" aria-labelledby="module-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <form method="post" asp-page-handler="Add" id="module-form"
                      data-add-url="@Url.Page("/ModuleManagement", "Add")"
                      data-update-url="@Url.Page("/ModuleManagement", "Update")"
                      data-containers-url="@Url.Page("/ModuleManagement", "Containers")"
                      data-services-url="@Url.Page("/ModuleManagement", "Services")">
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title fs-5" id="module-modal-title">Add module</h2>
                            <p class="text-muted small mb-0">Configure a service to display on the dashboard.</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                        @if (Model.ReopenHandler is not null && TempData.Peek("ErrorMessage") is string formError) { <div class="alert alert-danger" data-module-form-error>@formError</div> }
                        <input asp-for="Module.Id" type="hidden"/>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Module.Name" class="form-label"></label>
                                <input asp-for="Module.Name" class="form-control" autocomplete="off"
                                       placeholder="Status page"/>
                            </div>
                            <div class="col-12">
                                <label asp-for="Module.Description" class="form-label"></label>
                                <textarea asp-for="Module.Description" class="form-control" rows="3"
                                          placeholder="A short description of this module"></textarea>
                            </div>
                            <div class="col-md-6" id="module-host-field">
                                <label asp-for="Module.HostId" class="form-label"></label>
                                <select asp-for="Module.HostId" class="form-select" data-searchable-select data-search-placeholder="Search hosts…">
                                    <option value="">No host (HTTP/S or Minecraft)</option>
                                    @foreach (var host in Model.Hosts) {
                                        <option value="@host.Id">@host.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6" id="module-type-field">
                                <label asp-for="Module.TypeId" class="form-label"></label>
                                <select asp-for="Module.TypeId" class="form-select" data-searchable-select data-search-placeholder="Search module types…" required>
                                    @foreach (var type in Model.Types) {
                                        <option value="@type.Id" data-type-name="@type.Name">@type.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12" id="module-health-url-field">
                                <label asp-for="Module.HealthCheckUrl" class="form-label"></label>
                                <input asp-for="Module.HealthCheckUrl" class="form-control" type="url"
                                       placeholder="https://service.example/health"/>
                                <div class="form-text">Optional. A successful HTTP response is shown as healthy.</div>
                            </div>
                            <div class="col-12 d-none" id="module-container-field">
                                <label asp-for="Module.ContainerId" class="form-label"></label>
                                <select asp-for="Module.ContainerId" class="form-select" data-searchable-select data-search-placeholder="Search containers by name, image, or status…" aria-describedby="module-container-help" disabled>
                                    <option value="">Select a host to load containers</option>
                                </select>
                                <div class="form-text" id="module-container-help" role="status">
                                    Containers are loaded live from the selected host's agent.
                                </div>
                            </div>
                            <div class="col-12 d-none" id="module-service-field">
                                <label asp-for="Module.ServiceName" class="form-label"></label>
                                <select asp-for="Module.ServiceName" class="form-select" data-searchable-select data-search-placeholder="Search services by unit, description, or status…" aria-describedby="module-service-help" disabled>
                                    <option value="">Select a host to load services</option>
                                </select>
                                <div class="form-text" id="module-service-help" role="status">
                                    Services are loaded live from the selected host's agent.
                                </div>
                            </div>
                            <div class="col-12 d-none module-type-fields" id="module-steam-field">
                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <label asp-for="Module.SteamServerAddress" class="form-label"></label>
                                        <input asp-for="Module.SteamServerAddress" class="form-control"
                                               placeholder="steam.example.com" aria-describedby="module-steam-help" disabled/>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="Module.SteamQueryPort" class="form-label"></label>
                                        <input asp-for="Module.SteamQueryPort" class="form-control" type="number"
                                               min="1" max="65535" aria-describedby="module-steam-help" disabled/>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-text" id="module-steam-help">Steam server query. Enter the server's query port, which may differ from its game port.</div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check form-switch">
                                            <input asp-for="Module.SteamQueryPlayers" class="form-check-input" disabled/>
                                            <label asp-for="Module.SteamQueryPlayers" class="form-check-label"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 d-none module-type-fields" id="module-minecraft-field">
                                <div class="row g-3">
                                    <div class="col-md-8">
                                        <label asp-for="Module.MinecraftServerAddress" class="form-label"></label>
                                        <input asp-for="Module.MinecraftServerAddress" class="form-control"
                                               placeholder="minecraft.example.com" aria-describedby="module-minecraft-help" disabled/>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="Module.MinecraftServerPort" class="form-label"></label>
                                        <input asp-for="Module.MinecraftServerPort" class="form-control" type="number"
                                               min="1" max="65535" aria-describedby="module-minecraft-help" disabled/>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-text" id="module-minecraft-help">Minecraft Java Edition server-list ping. DNS SRV records are not resolved; enter the actual port.</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <label asp-for="Module.ManagementUrl" class="form-label"></label>
                                <input asp-for="Module.ManagementUrl" class="form-control" type="url"
                                       placeholder="https://service.example"/>
                                <div class="form-text">Optional. Adds an Open button to the module tile.</div>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="Module.IsEnabled" class="form-check-input"/>
                                    <label asp-for="Module.IsEnabled" class="form-check-label"></label>
                                </div>
                            </div>
                            <div class="col-12 d-none" id="module-audit-comment-field">
                                <label for="module-audit-comment" class="form-label">Audit comment</label>
                                <textarea class="form-control" id="module-audit-comment" name="AuditComment"
                                          rows="2" maxlength="@AuditLogModel.MaxCommentLength" disabled
                                          placeholder="Why is this change being made?"></textarea>
                                <div class="form-text">Required when editing. Maximum @AuditLogModel.MaxCommentLength characters.</div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="save-module">Add module</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}



@section Scripts {
    <script src="~/js/module-order.js" asp-append-version="true"></script>
    <script type="application/json" id="module-editor-state">@Json.Serialize(new {
        retry = Model.ReopenHandler,
        auditComment = Model.AuditComment,
        containerId = Model.Module.ContainerId,
        serviceName = Model.Module.ServiceName
    })</script>
    <script src="~/js/module-editor.js" asp-append-version="true"></script>
}
