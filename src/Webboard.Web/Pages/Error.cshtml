@page
@model ErrorModel
@{ ViewData["Title"] = "Request failed"; }
<section class="empty-state">
    <h1>We couldn't complete your request</h1>
    <p class="text-muted">Reload the page and try again. If a service action was in progress, check its current state before repeating it.</p>
    @if (Model.ShowRequestId) {
        <p>When reporting the issue, include this reference: <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index" class="btn btn-primary">Return to modules</a>
</section>
