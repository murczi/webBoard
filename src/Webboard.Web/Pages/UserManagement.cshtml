@page
@model UserManagementModel
@using Webboard.Domain.Model.AuditLogs
@{
    ViewData["Title"] = "User management";
    ViewData["FullWidth"] = true;
}

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
    <div>
        <p class="text-primary fw-semibold text-uppercase small mb-1">Administration</p>
        <h1 class="h2 mb-1">User management</h1>
        <p class="text-muted mb-0">View everyone registered with Webboard.</p>
    </div>
    <span class="badge rounded-pill text-bg-primary fs-6 px-3 py-2">
        @Model.Users.Count @(Model.Users.Count == 1 ? "user" : "users")
    </span>
</div>

@if (TempData["StatusMessage"] is string statusMessage) {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @statusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage) {
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm user-list-card">
    @if (Model.Users.Count == 0) {
        <div class="card-body text-center py-5">
            <h2 class="h5">No users found</h2>
            <p class="text-muted mb-0">Registered users will appear here.</p>
        </div>
    }
    else {
        <div class="user-table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                <tr>
                    <th scope="col" class="user-id-column">ID</th>
                    <th scope="col">Username</th>
                    <th scope="col" class="user-actions-column"><span class="visually-hidden">Actions</span></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var user in Model.Users) {
                    <tr>
                        <td class="text-muted">@user.Id</td>
                        <td class="fw-semibold">@user.Name</td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light user-actions-button"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Actions for @user.Name">
                                    <span aria-hidden="true">&#9776;</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    @if (Model.CanUpdateUsers) {
                                        <li>
                                            <button type="button"
                                                    class="dropdown-item js-edit-access"
                                                    data-user-id="@user.Id"
                                                    data-user-name="@user.Name"
                                                    data-access-url="@Url.Page("/UserManagement", "Access", new { userId = user.Id })">
                                                Set CRUD access
                                            </button>
                                        </li>
                                    }
                                    @if (Model.CanReadLogs) {
                                        <li>
                                            <button type="button" class="dropdown-item js-view-logs"
                                                    data-logs-url="@Url.Page("/UserManagement", "Logs", new { userId = user.Id })"
                                                    data-logs-target="@user.Name">Logs</button>
                                        </li>
                                    }
                                    @if (Model.CanDeleteUsers) {
                                        <li><hr class="dropdown-divider"/></li>
                                        <li>
                                            @if (Model.CurrentUserId == user.Id) {
                                                <button type="button"
                                                        class="dropdown-item text-danger"
                                                        disabled
                                                        title="You cannot delete your own account">
                                                    Delete user
                                                </button>
                                            }
                                            else {
                                                <form method="post"
                                                      asp-page-handler="Delete"
                                                      asp-route-userId="@user.Id"
                                                      onsubmit="return confirm('Delete this user? They will no longer be able to sign in.');">
                                                    <button type="submit" class="dropdown-item text-danger">Delete user</button>
                                                </form>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.CanUpdateUsers) {
<div class="modal fade" id="access-modal" tabindex="-1" aria-labelledby="access-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="SaveAccess" id="access-form">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title fs-5" id="access-modal-title">CRUD access</h2>
                        <p class="text-muted small mb-0" id="access-modal-user"></p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="userId" id="access-user-id"/>
                    <div id="access-loading" class="text-center text-muted py-5" role="status">
                        Loading access settings&hellip;
                    </div>
                    <div id="access-error" class="alert alert-danger d-none" role="alert">
                        Access settings could not be loaded. Close the window and try again.
                    </div>
                    <div id="access-fields" class="table-responsive d-none">
                        <table class="table align-middle mb-0 access-table">
                            <thead>
                            <tr>
                                <th scope="col">Resource</th>
                                <th scope="col" class="text-center">Create</th>
                                <th scope="col" class="text-center">Read</th>
                                <th scope="col" class="text-center">Update</th>
                                <th scope="col" class="text-center">Delete</th>
                            </tr>
                            </thead>
                            <tbody id="access-rows"></tbody>
                        </table>
                    </div>
                    <p class="small text-muted mt-3 mb-0 d-none" id="access-note">
                        Create, update, or delete access automatically includes read access. Module types and audit logs are read-only resources.
                    </p>
                    <div class="mt-4">
                        <label for="access-audit-comment" class="form-label">Audit comment</label>
                        <textarea class="form-control" id="access-audit-comment" name="AuditComment"
                                  rows="2" maxlength="@AuditLogModel.MaxCommentLength" required
                                  placeholder="Why is this access being changed?"></textarea>
                        <div class="form-text">Required. Maximum @AuditLogModel.MaxCommentLength characters.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="access-save" disabled>Save access</button>
                </div>
            </form>
        </div>
    </div>
</div>

}

@if (Model.CanReadLogs) {
    <partial name="Shared/_AuditLogModal"/>
}

@section Scripts {
    @if (Model.CanReadLogs) {
        <script src="~/js/audit-logs.js" asp-append-version="true"></script>
    }
    <script>
        (() => {
            const modalElement = document.getElementById('access-modal');
            if (!modalElement) return;
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            const form = document.getElementById('access-form');
            const userIdInput = document.getElementById('access-user-id');
            const userLabel = document.getElementById('access-modal-user');
            const loading = document.getElementById('access-loading');
            const error = document.getElementById('access-error');
            const fields = document.getElementById('access-fields');
            const rows = document.getElementById('access-rows');
            const note = document.getElementById('access-note');
            const saveButton = document.getElementById('access-save');
            const auditComment = document.getElementById('access-audit-comment');
            const resourceLabels = {
                Users: 'Users',
                Hosts: 'Hosts',
                Modules: 'Modules',
                ModuleTypes: 'Module types',
                AuditLogs: 'Audit logs'
            };

            const addHiddenInput = (container, name, value) => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = name;
                input.value = value;
                container.appendChild(input);
            };

            const addAccessCheckbox = (row, index, property, checked, disabled) => {
                const cell = document.createElement('td');
                cell.className = 'text-center';

                const input = document.createElement('input');
                input.type = 'checkbox';
                input.className = 'form-check-input';
                input.name = `Access[${index}].${property}`;
                input.value = 'true';
                input.checked = checked;
                input.disabled = disabled;
                input.setAttribute('aria-label', `${property.replace('Can', '')} ${row.dataset.resource}`);

                cell.appendChild(input);
                row.appendChild(cell);
            };

            const renderAccess = access => {
                rows.replaceChildren();
                access.forEach((item, index) => {
                    const row = document.createElement('tr');
                    row.dataset.resource = resourceLabels[item.resource] ?? item.resource;

                    const resourceCell = document.createElement('th');
                    resourceCell.scope = 'row';
                    resourceCell.textContent = row.dataset.resource;
                    row.appendChild(resourceCell);

                    addHiddenInput(resourceCell, `Access[${index}].Resource`, item.resource);
                    addAccessCheckbox(row, index, 'CanCreate', item.canCreate, item.isReadOnlyResource);
                    addAccessCheckbox(row, index, 'CanRead', item.canRead, false);
                    addAccessCheckbox(row, index, 'CanUpdate', item.canUpdate, item.isReadOnlyResource);
                    addAccessCheckbox(row, index, 'CanDelete', item.canDelete, item.isReadOnlyResource);
                    const read = row.querySelector(`[name="Access[${index}].CanRead"]`);
                    const writes = [...row.querySelectorAll('input[type="checkbox"]')].filter(input => input !== read);
                    const ensureRead = () => {
                        if (writes.some(input => input.checked)) read.checked = true;
                    };
                    row.addEventListener('change', ensureRead);
                    ensureRead();
                    rows.appendChild(row);
                });
            };

            document.querySelectorAll('.js-edit-access').forEach(button => {
                button.addEventListener('click', async () => {
                    userIdInput.value = button.dataset.userId;
                    userLabel.textContent = button.dataset.userName;
                    loading.classList.remove('d-none');
                    error.classList.add('d-none');
                    fields.classList.add('d-none');
                    note.classList.add('d-none');
                    saveButton.disabled = true;
                    auditComment.value = '';
                    modal.show();

                    try {
                        const response = await fetch(button.dataset.accessUrl, {
                            headers: { Accept: 'application/json' }
                        });
                        if (!response.ok)
                            throw new Error(`Request failed with status ${response.status}`);

                        renderAccess(await response.json());
                        fields.classList.remove('d-none');
                        note.classList.remove('d-none');
                        saveButton.disabled = false;
                    }
                    catch {
                        error.classList.remove('d-none');
                    }
                    finally {
                        loading.classList.add('d-none');
                    }
                });
            });

            form.addEventListener('submit', () => {
                saveButton.disabled = true;
                saveButton.textContent = 'Saving…';
            });
        })();
    </script>
}
