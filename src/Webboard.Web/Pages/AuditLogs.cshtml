@page
@model AuditLogsModel
@using Webboard.Domain.Model.AuditLogs
@{ ViewData["Title"] = "Audit log"; }
<div class="page-heading"><div><p class="eyebrow">Activity & accountability</p><h1>Audit log</h1><p class="text-muted">Explore changes across your workspace. All dates and times are UTC.</p></div></div>
<form method="get" class="card p-4 mb-4">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="audit-filters">
        <div><label asp-for="Resource" class="form-label">Resource type</label><select asp-for="Resource" class="form-select"><option value="">All resources</option><option>Modules</option><option>Hosts</option><option>Users</option></select></div>
        <div><label asp-for="Action" class="form-label">Action</label><select asp-for="Action" class="form-select"><option value="">All actions</option>@foreach (var action in Enum.GetValues<AuditAction>()) { <option value="@action">@AuditLogsModel.ActionLabel(action)</option> }</select></div>
        <div><label asp-for="ActorId" class="form-label">Actor</label><select asp-for="ActorId" class="form-select"><option value="">All actors</option>@foreach (var actor in Model.Actors) { <option value="@actor.Id">@actor.Name (#@actor.Id)</option> }</select></div>
        <div><label asp-for="From" class="form-label">From (UTC)</label><input asp-for="From" type="date" class="form-control"/></div>
        <div><label asp-for="To" class="form-label">Through (UTC)</label><input asp-for="To" type="date" class="form-control"/></div>
        <div class="d-flex gap-2"><button class="btn btn-primary">Apply filters</button><a asp-page="/AuditLogs" class="btn btn-outline-secondary">Reset</a></div>
    </div>
    @if (Model.TargetId.HasValue) {
        <input asp-for="TargetId" type="hidden"/>
        <div class="mt-3 small">Filtered to @Model.Resource #@Model.TargetId <a class="ms-2" href="@Model.PageUrl(1, true)">Remove target filter</a></div>
    }
</form>
@if (ModelState.IsValid) {
    <div class="d-flex justify-content-between mb-3"><span class="text-muted">@Model.Results.TotalItems matching events</span><span class="text-muted small">Newest first</span></div>
    @if (Model.Results.Items.Count == 0) {
        <div class="empty-state"><h2>No matching events</h2><p class="text-muted">Try changing the filters, or check back after changes are made.</p><a asp-page="/AuditLogs">Clear filters</a></div>
    } else {
        <div class="card table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Time (UTC)</th><th>Resource</th><th>Item</th><th>Action</th><th>Actor</th><th>Comment</th></tr></thead><tbody>
        @foreach (var log in Model.Results.Items) {
            <tr><td class="text-nowrap"><time datetime="@log.DateCreated.ToString("O")">@log.DateCreated.ToString("yyyy-MM-dd HH:mm:ss")</time></td><td>@log.Resource</td>
            <td>@(log.TargetName ?? "Unknown item") <small class="text-muted">#@log.TargetId</small></td>
            <td><span class="badge text-bg-secondary">@AuditLogsModel.ActionLabel(log.Action)</span></td><td>@log.ActorName</td><td class="audit-comment">@log.Comment
                @if (log.OperationId.HasValue) {
                    <details><summary>@log.Operation — @log.Outcome</summary>
                    <p>@log.TargetSnapshot</p><p>@log.Failure</p>
                    @if (log.ExitCode.HasValue) { <p>Exit code: @log.ExitCode</p> }
                    @if (!string.IsNullOrEmpty(log.Output)) { <pre class="text-wrap">@log.Output</pre> }
                    <small>Request @log.OperationId · Completed @log.CompletedAt</small></details>
                }</td></tr>
        }
        </tbody></table></div>
        <nav class="d-flex justify-content-between align-items-center gap-3 mt-4" aria-label="Audit log pages">
            <span class="text-muted small">Page @Model.Results.Page of @Model.Results.TotalPages · @Model.Results.PageSize per page</span>
            <div class="d-flex gap-2">
                @if (Model.Results.Page > 1) { <a class="btn btn-outline-secondary" href="@Model.PageUrl(Model.Results.Page - 1)">Previous</a> }
                else { <button class="btn btn-outline-secondary" disabled>Previous</button> }
                @if (Model.Results.Page < Model.Results.TotalPages) { <a class="btn btn-outline-secondary" href="@Model.PageUrl(Model.Results.Page + 1)">Next</a> }
                else { <button class="btn btn-outline-secondary" disabled>Next</button> }
            </div>
        </nav>
    }
}
