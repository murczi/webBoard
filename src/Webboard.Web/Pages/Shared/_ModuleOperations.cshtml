@model Webboard.Domain.Model.Modules.ModuleModel
@using Webboard.Domain.Model.Modules
@if (ModuleEligibility.CanOperate(Model) && ModuleAccess.Has(User, ModuleAccess.Read) && ModuleAccess.Has(User, ModuleAccess.Operations)) {
    <div class="dropdown module-operations" data-capabilities-url="@Url.Page("/Operations", "Capabilities", new { moduleId = Model.Id })">
        <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle"
                data-bs-toggle="dropdown" aria-expanded="false" aria-label="Operations for @Model.Name">Operations</button>
        <ul class="dropdown-menu dropdown-menu-end" data-operation-actions><li><span class="dropdown-item-text small">Open to load operations…</span></li></ul>
    </div>
}
