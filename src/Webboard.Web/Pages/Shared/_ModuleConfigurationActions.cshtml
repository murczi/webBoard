@model Webboard.Domain.Model.Modules.ModuleModel
@{
    var canUpdate = ModuleAccess.Has(User, ModuleAccess.Update);
    var canDelete = ModuleAccess.Has(User, ModuleAccess.Delete);
    var canReadLogs = AuditLogAccess.HasRead(User);
}
<div class="configuration-actions d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3 pt-3">
    <partial name="_ModuleOperations" model="Model" />
    @if (canUpdate) {
        <button type="button" class="btn btn-sm btn-outline-primary js-edit-module"
                data-bs-toggle="modal" data-bs-target="#module-modal"
                data-module-edit="@System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web))">Edit module</button>
    }
    @if (canReadLogs || canDelete) {
        <div class="dropdown ms-auto">
            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More actions for @Model.Name">More</button>
            <ul class="dropdown-menu dropdown-menu-end">
                @if (canReadLogs) { <li><a class="dropdown-item" asp-page="/AuditLogs" asp-route-Resource="Modules" asp-route-TargetId="@Model.Id">Audit history</a></li> }
                @if (canReadLogs && canDelete) { <li><hr class="dropdown-divider"/></li> }
                @if (canDelete) {
                    <li><form method="post" asp-page="/ModuleManagement" asp-page-handler="Delete" asp-route-moduleId="@Model.Id" data-confirm-delete="@Model.Name">
                        <button class="dropdown-item text-danger" type="submit">Delete module</button>
                    </form></li>
                }
            </ul>
        </div>
    }
</div>

<pre class="operation-result small mt-2 mb-0" role="status" hidden></pre>
