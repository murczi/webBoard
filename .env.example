# Optional: local dotnet development only. Docker Compose is configured directly
# in deploy/docker-compose.yml and does not need this file.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=replace-me

# Used by local dotnet commands. Compose uses Host=database inside the UI container.
ConnectionStrings__WebboardDatabase="Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"

# Used when running the UI locally; Compose has its own signing-key setting.
# Replace with output from: openssl rand -hex 32
Authentication__Jwt__SigningKey=
